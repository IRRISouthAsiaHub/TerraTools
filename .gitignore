# ── Build outputs (PyInstaller, Inno Setup, macOS build) ──────────────────
/dist/
/build/
/installer_output/
build_macos/work/

# ── Windows portable R runtime (~1.5 GB) ──────────────────────────────────
# Needed only on the PC that builds the Windows installer (installer.iss).
# Keep a backup copy outside git; the macOS build makes its own R runtime.
/r_runtime_build/

# ── Frontend: installed packages and the generated bundle ────────────────
# `npm ci` restores node_modules; terratools.spec / build_macos.sh rebuild dist.
frontend/node_modules/
frontend/dist/

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
r_env/

# ── Results written by the tools at run time ──────────────────────────────
tools/**/results/

# ── Old HTML frontend kept locally for reference ──────────────────────────
_legacy_html/

# ── OS / editor clutter ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
.Rhistory
.claude/
